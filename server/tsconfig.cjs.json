{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-cjs",
    "rootDir": "./src",
    "module": "CommonJS",
    "moduleResolution": "node",
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "dist-cjs", "**/*.test.ts"]
}
