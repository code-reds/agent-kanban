{
  "name": "@agent-kanban/server",
  "version": "1.0.0",
  "license": "GPL-3.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./permissions/permission-checker.js": "./dist/permissions/permission-checker.js",
    "./permissions/*": "./dist/permissions/*.js",
    "./workflow/*": "./dist/workflow/*.js",
    "./services/*": "./dist/services/*.js",
    "./db": "./dist/db/index.js",
    "./db/database.js": "./dist/db/database.js",
    "./db/queries/projects.js": "./dist/db/queries/projects.js",
    "./db/queries/tickets.js": "./dist/db/queries/tickets.js",
    "./db/queries/kanban.js": "./dist/db/queries/kanban.js",
    "./db/seed.js": "./dist/db/seed.js"
  },
  "bin": {
    "agent-kanban": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-migrations.mjs",
    "postbuild": "node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:unit": "vitest --config vitest.unit.config.ts",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@types/archiver": "^7.0.0",
    "@vitest/coverage-v8": "^3.1.1",
    "archiver": "^8.0.0",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "typescript": "^5.8.0",
    "vite": "^6.2.4",
    "vitest": "^3.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "supertest": "^7.0.0"
  }
}
